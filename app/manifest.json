{
  "manifest_version": 3,
  "name": "Study Arcade",
  "version": "1.0.0",
  "description": "Turn flashcards or term lists on any web page into study games. Select terms or open a flashcard set, then click the icon.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Play these cards in Study Arcade",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ]
}
